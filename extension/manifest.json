{
  "manifest_version": 3,
  "name": "Scamurai - Job Posting Fraud Scanner",
  "version": "1.0.0",
  "description": "Scans job postings on LinkedIn, Indeed, Naukri, and more for fraud signals using ML.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan with Scamurai",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "https://scamurai-job-fraud-scanner.onrender.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.indeed.com/*",
        "https://*.indeed.com/*",
        "https://www.naukri.com/*",
        "https://www.apna.co/*",
        "https://apna.co/*",
        "https://www.foundit.in/*",
        "https://www.shine.com/*",
        "https://internshala.com/*",
        "https://www.glassdoor.co.in/*",
        "https://www.glassdoor.com/*",
        "https://wellfound.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

